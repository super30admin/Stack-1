// Your code here along with comments explaining your approach:monotonic decresing stack approach
class Solution {
    public int[] dailyTemperatures(int[] temperatures) {
        Stack<Integer> st=new Stack<>();//to process elements
        int[] result=new int[temperatures.length];//to store results
        // Arrays.fill(result,-1);
        for(int i=0;i<temperatures.length;i++){
            int curr=temperatures[i];
            while(!st.isEmpty() && curr > temperatures[st.peek()]){//if curr temp is greater than prev temp
                int popped=st.pop();
                result[popped] =i-popped;
            }
          st.push(i);//push to stack
        }
        return result;
    }
}