// Approach : From Brute force we fix the current day and scan for the future day for higher temperature.
// In order to eliminate those nested iterations we can utilize some additional data structure as a place holder and try to resolve the future element first than the current element.
// if unresolved then store them in the data structure.
// So last unresolved element has to be resolved first - LIFO (USE STACK)
// Time : O(2n)
// Space : O(n) // stack space
class Solution {
    public int[] dailyTemperatures(int[] temperatures) {
        int n = temperatures.length;
        int[] result = new int[n];

        Stack<Integer> stk = new Stack <>(); // will be a monotonically increasing stock
        for(int i =0;i<n;i++){// go over all the temperatures
            while(!stk.isEmpty() && temperatures[i]>temperatures[stk.peek()]){
                int popped = stk.pop();
                result[popped]=i - popped;
            }
            stk.push(i); // very first element
        }
        return result;
    }
}