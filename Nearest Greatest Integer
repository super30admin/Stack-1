// Approach : From brute force fix the current element and scan for the greater element in the rest of the array
// In order to eliminate the nested iterations we can use additional data structure where you could store the unresolved nextGreaterElement in it.
// So last unresolved element has to be resolved first - LIFO (USE STACK)
// Time : O(2n)
// Space : O(n)
class Solution {
    public int[] nextGreaterElements(int[] nums) {
        int n = nums.length;
        int[] result = new int[n];
        Arrays.fill(result , -1); // if you don't have next greater element fill that array position with -1
        Stack<Integer> stk = new Stack<>();
        // In the second pass we might be pushing the element again and try to resolve it. - So we can optimize it 
        for(int i =0;i<2*n;i++){ // first pass i-> 0 to n and in second pass i -> i%n to n
            while(!stk.isEmpty() && nums[i%n]>nums[stk.peek()]){
                int popped = stk.pop();
                result[popped] = nums[i%n];
            }
            stk.push(i%n);
        }
        return result;
    }
}

